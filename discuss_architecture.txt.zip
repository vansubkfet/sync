10. Tạo Client để start Workflow

Tạo:

client.py
import asyncio
import uuid

from temporalio.client import Client

from app.workflows import AgentWorkflow


async def main():

    client = await Client.connect(
        "localhost:7233"
    )

    workflow_id = f"agent-poc-{uuid.uuid4()}"

    result = await client.start_workflow(
        AgentWorkflow.run,
        "Change production order approval configuration",
        id=workflow_id,
        task_queue="agent-poc",
    )

    print()
    print("Workflow started")
    print("----------------")
    print(f"Workflow ID: {workflow_id}")
    print(f"Run ID:      {result.first_execution_run_id}")
    print()
    print("Workflow is now running.")
    print("It will wait for human approval after planning.")


if __name__ == "__main__":
    asyncio.run(main())
