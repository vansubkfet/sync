Kiểm tra:

python -c "import temporalio; print(temporalio.__version__)"

Temporal có SDK chính thức cho Python; documentation hiện tại cung cấp quickstart/developer documentation cho việc xây workflow bằng SDK.

6. Tạo Activities

Tạo:

app/activities.py

Nội dung:

from temporalio import activity


@activity.defn
async def analyze_request(request: str) -> dict:
    print(f"[Analyze Agent] Processing request: {request}")

    return {
        "status": "completed",
        "request": request,
        "summary": "User wants to change a production management configuration.",
        "requirements": [
            "Understand current configuration",
            "Identify expected new behavior",
            "Verify impact",
        ],
    }


@activity.defn
async def review_analysis(analysis: dict) -> dict:
    print("[Analyze Review Agent] Reviewing analysis")

    return {
        "status": "PASS",
        "reason": "Analysis contains sufficient information for planning.",
    }


@activity.defn
async def create_plan(analysis: dict) -> dict:
    print("[Plan Agent] Creating implementation plan")

    return {
        "status": "completed",
        "steps": [
            "Inspect current configuration",
            "Define required changes",
            "Implement configuration change",
            "Run tests",
            "Verify expected behavior",
        ],
    }

Hiện tại đây chưa phải AI Agent.

Chúng chỉ là fake activities.

Điều này là chủ ý.

7. Tạo Workflow

Tạo:

app/workflows.py

Nội dung:

from datetime import timedelta

from temporalio import workflow

with workflow.unsafe.imports_passed_through():
    from app.activities import (
        analyze_request,
        review_analysis,
        create_plan,
    )


@workflow.defn
class AgentWorkflow:

    def __init__(self):
        self.approved = False
        self.rejected = False

    @workflow.run
    async def run(self, request: str) -> dict:

        # ==========================================
        # PHASE 1: ANALYZE
        # ==========================================

        analysis = await workflow.execute_activity(
            analyze_request,
            request,
            start_to_close_timeout=timedelta(minutes=5),
        )

        # ==========================================
        # PHASE 2: ANALYZE REVIEW
        # ==========================================

        review = await workflow.execute_activity(
            review_analysis,
            analysis,
            start_to_close_timeout=timedelta(minutes=5),
        )

        if review["status"] != "PASS":
            return {
                "status": "REJECTED",
                "phase": "ANALYZE",
                "reason": review["reason"],
            }

        # ==========================================
        # PHASE 3: PLAN
        # ==========================================

        plan = await workflow.execute_activity(
            create_plan,
            analysis,
            start_to_close_timeout=timedelta(minutes=5),
        )

        # ==========================================
        # PHASE 4: HUMAN APPROVAL
        # ==========================================

        await workflow.wait_condition(
            lambda: self.approved or self.rejected
        )

        if self.rejected:
            return {
                "status": "REJECTED",
                "phase": "HUMAN_APPROVAL",
            }

        # ==========================================
        # COMPLETED
        # ==========================================

        return {
            "status": "COMPLETED",
            "analysis": analysis,
            "plan": plan,
        }

    @workflow.signal
    async def approve(self):
        self.approved = True

    @workflow.signal
    async def reject(self):
        self.rejected = True

Đây là phần quan trọng nhất của PoC.

Bạn đang có:

Analyze
   ↓
Review
   ↓
Plan
   ↓
WAIT

Workflow sẽ không exit khi đến wait_condition().

Nó sẽ chờ signal từ bên ngoài.

8. Tạo Worker

Tạo:

app/worker.py
import asyncio

from temporalio.client import Client
from temporalio.worker import Worker

from app.workflows import AgentWorkflow
from app.activities import (
    analyze_request,
    review_analysis,
    create_plan,
)


async def main():

    client = await Client.connect(
        "localhost:7233"
    )

    worker = Worker(
        client,
        task_queue="agent-poc",
        workflows=[
            AgentWorkflow,
        ],
        activities=[
            analyze_request,
            review_analysis,
            create_plan,
        ],
    )

    print("Temporal Worker started.")
    print("Task Queue: agent-poc")

    await worker.run()


if __name__ == "__main__":
    asyncio.run(main())

Nếu Temporal của bạn đang dùng host/port khác:

Client.connect("YOUR_HOST:YOUR_PORT")
