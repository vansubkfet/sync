13. Tạo Human Approval Client

Tạo:

approve.py
import asyncio
import sys

from temporalio.client import Client


async def main():

    if len(sys.argv) != 3:
        print(
            "Usage: python approve.py <workflow_id> <approve|reject>"
        )
        return

    workflow_id = sys.argv[1]
    action = sys.argv[2]

    client = await Client.connect(
        "localhost:7233"
    )

    handle = client.get_workflow_handle(
        workflow_id
    )

    if action == "approve":

        await handle.signal("approve")

        print(
            f"Workflow {workflow_id} approved."
        )

    elif action == "reject":

        await handle.signal("reject")

        print(
            f"Workflow {workflow_id} rejected."
        )

    else:

        print(
            "Action must be approve or reject."
        )


if __name__ == "__main__":
    asyncio.run(main())
